{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "house-of-munse",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // token.ts가 node:crypto를 씁니다.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // /collection 같은 주소로 바로 들어와도 index.html을 내려 줍니다.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 공방지기 질문(/api/ask). 무료 플랜이라 하루 무료 사용량을 넘으면 과금되지 않고 요청이 실패합니다.
  // AI 연결은 로컬 개발에서도 실제 Workers AI를 부릅니다 (무료 사용량에서 차감).
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "house-of-munse",
      // 배포용 D1 (`wrangler d1 create house-of-munse`로 만든 것).
      "database_id": "bb43a60e-8510-456c-912f-76cd81971c88",
      // 로컬 개발(.wrangler)의 DB 파일은 이 id로 정해집니다. 배포 id와 따로 두어 로컬 데이터가 바뀌지 않게 합니다.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
